generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          UserRole       @default(PATIENT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointments  Appointment[]  @relation("PatientAppointments")
  doctor        Doctor?
  notifications Notification[]
  reviewedEmergencies Appointment[] @relation("EmergencyReviewer")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  doctors     Doctor[]
}

model Doctor {
  id             Int           @id @default(autoincrement())
  userId         Int           @unique
  departmentId   Int
  specialization String
  qualifications String?
  serviceMode    ServiceMode   @default(CONSULTATION)
  availability   Boolean       @default(true)
  createdAt      DateTime      @default(now())
  appointments   Appointment[]
  queueSequences QueueSequence[]
  department     Department    @relation(fields: [departmentId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              Int               @id @default(autoincrement())
  patientId       Int
  doctorId        Int
  appointmentDate DateTime
  appointmentTime     String
  slot                AppointmentSlot?
  bookingType         BookingType           @default(NORMAL)
  emergencyStatus     EmergencyStatus       @default(NOT_APPLICABLE)
  surchargeAmount     Int                   @default(0)
  emergencyReviewedAt DateTime?
  emergencyReviewedById Int?
  status              AppointmentStatus     @default(BOOKED)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  doctor              Doctor                @relation(fields: [doctorId], references: [id])
  patient             User                  @relation("PatientAppointments", fields: [patientId], references: [id])
  emergencyReviewedBy User?                 @relation("EmergencyReviewer", fields: [emergencyReviewedById], references: [id], onDelete: SetNull)
  queue               Queue?

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([doctorId, appointmentDate, slot])
  @@index([emergencyStatus])
}

model Queue {
  id            Int           @id @default(autoincrement())
  appointmentId Int           @unique
  tokenNumber   String
  priority      QueuePriority @default(NORMAL)
  status        QueueStatus   @default(WAITING)
  joinedAt      DateTime      @default(now())
  servedAt      DateTime?
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([priority])
}

model QueueSequence {
  id              Int             @id @default(autoincrement())
  doctorId        Int
  appointmentDate DateTime        @db.Date
  slot            AppointmentSlot
  lastNumber      Int             @default(0)
  doctor          Doctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, appointmentDate, slot])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum ServiceMode {
  CONSULTATION
  DIAGNOSTIC
}

enum AppointmentSlot {
  MORNING
  AFTERNOON
}

enum BookingType {
  NORMAL
  EMERGENCY
}

enum EmergencyStatus {
  NOT_APPLICABLE
  PENDING
  APPROVED
  DECLINED
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  SERVING
  COMPLETED
  SKIPPED
  CANCELLED
}

enum QueuePriority {
  NORMAL
  SENIOR
  EMERGENCY
}

enum NotificationType {
  QUEUE_UPDATE
  APPOINTMENT
  SYSTEM
}
