# Copy to backend/.env locally; never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/smart_hospital?schema=public"
# Generate a different random secret for every deployed environment (32+ random bytes).
JWT_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET"
PORT=5000
HOSPITAL_NAME="Janta Hospital"
HOSPITAL_LOCATION="Jahangirabad"
# Local Vite origin. For a separate deployed frontend, set its exact HTTPS origin(s), comma-separated.
FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Leave false until hospital staff explicitly approve skipping patients.
ENABLE_QUEUE_SKIP=false
# Optional: password assigned by the demo seed to its synthetic accounts.
SEED_DEMO_PASSWORD="ChangeThisDemoPassword"
# Booking slots and emergency surcharge (Janta Hospital pilot defaults)
MORNING_SLOT_ENABLED=true
MORNING_SLOT_LABEL=Morning · 9:00 AM–12:00 PM
MORNING_SLOT_TIME=9:00 AM–12:00 PM
AFTERNOON_SLOT_ENABLED=true
AFTERNOON_SLOT_LABEL=Afternoon · 2:00 PM–5:00 PM
AFTERNOON_SLOT_TIME=2:00 PM–5:00 PM
EMERGENCY_SURCHARGE=500
# Leave blank until the hospital confirms the normal consultation/service fee.
NORMAL_BOOKING_FEE=
